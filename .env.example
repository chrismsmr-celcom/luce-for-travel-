# Clé LiteAPI (sandbox ou production) : jamais dans le frontend
LITEAPI_KEY=
# Base du deep link Luviaplace
LUVIA_BASE_URL=https://luviaplace.com/checkout
# Secret pour signer les deep links (HMAC SHA-256), côté Luviaplace vous vérifiez le paramètre sig
LUVIA_SECRET=
# Nationalité par défaut des voyageurs (ISO-2)
DEFAULT_NATIONALITY=CD
# Cerveau de Luce (DeepSeek). Sans cette clé, seule la phrase manuelle fonctionne.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Réflexion DeepSeek V4 (laisser vide = désactivée)
DEEPSEEK_THINKING=
